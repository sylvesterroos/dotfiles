// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": true,
      "show_free_models": true,
    },
  },
  "diff_view_style": "split",
  "agent_servers": {
    "Hermes (forge)": {
      "default_mode": "accept_edits",
      "type": "custom",
      "command": "forge",
      "args": [
        "acp"
      ]
    },
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "model": "opencode-go/glm-5.2"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "low",
      },
      "type": "registry",
    },
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "colorize_brackets": true,
  "git_panel": {
    "tree_view": true,
  },
  "ssh_connections": [
    {
      "host": "bachus",
      "username": "sylvester",
      "args": [],
      "projects": [
        {
          "paths": ["/srv/nixos/./"],
        },
      ],
    },
  ],
  "load_direnv": "direct",
  "title_bar": {
    "show_user_picture": false,
  },
  "tabs": {
    "git_status": true,
  },
  "calls": {
    "mute_on_join": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [".env"],
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  "show_edit_predictions": true,
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true
    },
    "tool_permissions": {
      "tools": {
        "mcp:nixos:nix": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://hermes-agent\\.nousresearch\\.com",
            },
          ],
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^ls\\s"
            },
            {
              "pattern": "^nix\\s+log(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^head\\b"
            }
          ],
        },
      },
    },
    "use_modifier_to_send": true,
    "profiles": {
      "ask": {
        "name": "Ask",
        "context_servers": {
          "tidewave-mcp": {
            "tools": {
              "search_package_docs": true,
              "project_eval": false,
              "get_source_location": true,
              "get_logs": true,
              "get_ecto_schemas": true,
              "execute_sql_query": false,
              "get_docs": true,
            },
          },
        },
      },
    },
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
    },
    "default_model": {
      "effort": "max",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
    },
    "commit_message_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
    },
    "model_parameters": [],
  },
  "vim_mode": true,
  "helix_mode": false,
  "hide_mouse": "never",
  "vertical_scroll_margin": 10,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "languages": {
    "Nix": {
      "language_servers": ["nil", "!nixd"],
      "format_on_save": "on",
    },
    "Markdown": {
      "preferred_line_length": 80,
    },
    "Elixir": {
      "language_servers": ["expert", "!elixir-ls", "!lexical", "!next-ls"],
      "wrap_guides": [98],
    },
    "HEEx": {
      "language_servers": [
        "expert",
        "!elixir-ls",
        "!lexical",
        "!next-ls",
        "tailwindcss-intellisense",
      ],
      "wrap_guides": [98],
    },
    "Nu": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "topiary",
          "arguments": ["format", "--language", "nu"],
          // "command": "nufmt",
          // "arguments": ["--stdin"],
        },
      },
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "soft_wrap": "none",
  "cursor_blink": false,
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Gruvbox Dark Hard",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "terminal": {
    "dock": "bottom",
    "blinking": "on",
    "line_height": "standard",
    "detect_venv": "off", // direnv does this
  },
  "file_types": {
    "env": [".env*"],
  },
  "inlay_hints": {
    "enabled": true,
  },
  "lsp": {
    "nil": {
      "settings": {
        "nix": {
          "flake": {
            "autoArchive": true,
            "nixpkgsInputName": "nixpkgs",
          },
        },
      },
    },
  },
}
