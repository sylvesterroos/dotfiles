// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "colorize_brackets": true,
  "git_panel": {
    "tree_view": true,
  },
  "ssh_connections": [
    {
      "host": "bachus",
      "username": "sylvester",
      "args": [],
      "projects": [
        {
          "paths": [
            "/etc/nixos/./"
          ]
        }
      ]
    }
  ],
  // Tell Zed to use direnv and direnv can use a flake.nix environment
  "load_direnv": "shell_hook",
  "title_bar": {
    "show_user_picture": false,
  },
  "tabs": {
    "git_status": true,
  },
  "calls": {
    "mute_on_join": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [".env"],
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
    "enabled_in_text_threads": false,
  },
  "show_edit_predictions": true,
  "agent": {
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
        "enable_thinking": true,
      },
    ],
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^ls\\s",
            },
          ],
        },
      },
    },
    "use_modifier_to_send": true,
    "profiles": {
      "ask": {
        "name": "Ask",
        "context_servers": {
          "tidewave-mcp": {
            "tools": {
              "search_package_docs": true,
              "project_eval": false,
              "get_source_location": true,
              "get_logs": true,
              "get_ecto_schemas": true,
              "execute_sql_query": false,
              "get_docs": true,
            },
          },
        },
      },
    },
    "play_sound_when_agent_done": true,
    "dock": "right",
    "default_profile": "ask",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "model_parameters": [],
  },
  "vim_mode": true,
  "helix_mode": false,
  "hide_mouse": "never",
  "vertical_scroll_margin": 10,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "languages": {
    "Nix": {
      "language_servers": ["nil", "!nixd"],
    },
    "Markdown": {
      "preferred_line_length": 80,
    },
    "Elixir": {
      "language_servers": ["expert", "!elixir-ls", "!lexical", "!next-ls"],
      "wrap_guides": [98],
    },
    "HEEx": {
      "language_servers": [
        "expert",
        "!elixir-ls",
        "!lexical",
        "!next-ls",
        "tailwindcss-intellisense",
      ],
      "wrap_guides": [98],
    },
    "Nu": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "topiary",
          "arguments": ["format", "--language", "nu"],
          // "command": "nufmt",
          // "arguments": ["--stdin"],
        },
      },
    },
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "soft_wrap": "none",
  "cursor_blink": false,
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "GitHub Dark Colorblind",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "terminal": {
    "dock": "bottom",
    "blinking": "on",
    "line_height": "standard",
    "detect_venv": "off", // direnv does this
  },
  "file_types": {
    "env": [".env*"],
  },
  "inlay_hints": {
    "enabled": true,
  },
  "lsp": {
    "nil": {
      "settings": {
        "nix": {
          "flake": {
            "autoArchive": true,
            "nixpkgsInputName": "nixpkgs",
          },
        },
      },
    },
  },
}
