// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "auto_update": false,
  "vim_mode": true,
  "ui_font_size": 20,
  "buffer_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "show_copilot_suggestions": true,
  "features": {
    "copilot": true
  },
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": []
        }
      }
    },
    "Markdown": {
      "preferred_line_length": 80
    },
    "Elixir": {
      "language_servers": ["elixir-ls", "!lexical", "!next-ls"],
      "wrap_guides": [98],
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "soft_wrap": "none",
  "cursor_blink": false,
  "scrollbar": {
    "show": "never"
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Gruvbox Dark Hard"
  },
  "terminal": {
    "dock": "bottom",
    "blinking": "on",
    "font_size": 18,
    "line_height": {
      "custom": 1.25
    }
  },
  "inlay_hints": {
    "enabled": true
  }
}
